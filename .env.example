# ── MedPrescription Environment Variables ──
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
#
# Production (VPS): keep the real .env OUTSIDE the git checkout, e.g.
#   /var/www/wellness.fig-byte.com/.env
# and point the deploy script / PM2 at it. The app loads via dotenv from
# the project root; the VPS ecosystem injects the same vars at process start.

# Server port (default 3000)
PORT=3000

# JWT signing secret — CHANGE THIS in production!
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://medprescription:your-db-password@localhost:5432/medprescription

# Uploaded files directory (default: <server>/uploads)
# UPLOAD_DIR=/var/www/medprescription/uploads

# OTP mode — 'false' in production once a real SMS/WhatsApp provider is wired.
# In mock mode every OTP is '123456' (still stored in the otps table).
OTP_MOCK=true

# Frontend origin for CORS (comma-separated if multiple)
# Example: https://wellness.fig-byte.com
CORS_ORIGIN=https://wellness.fig-byte.com
