# ── MedPrescription Environment Variables ──
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Server port (default 3000)
PORT=3000

# JWT signing secret — CHANGE THIS in production!
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://medprescription:your-db-password@localhost:5432/medprescription

# Uploaded files directory (default: <server>/uploads)
# UPLOAD_DIR=/var/www/medprescription/uploads

# OTP mode — 'false' in production (real OTP provider needed)
# In dev, 'true' makes every OTP code '123456'
OTP_MOCK=true

# Frontend origin for CORS (comma-separated if multiple)
# Example: https://medprescription.com,https://www.medprescription.com
CORS_ORIGIN=https://medprescription.com
